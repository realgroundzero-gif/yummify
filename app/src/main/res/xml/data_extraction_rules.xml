<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the Notion token stays on this device for cloud backups and device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="yummify_user_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="yummify_user_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
