<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_background_image" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_background" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="22dp" android:layout_height="22dp" android:background="@drawable/widget_wordmark_background"
                android:gravity="center" android:includeFontPadding="false" android:text="y" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:text="yummify"
                android:textColor="#F7F1EE" android:textSize="13sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Wochenplan"
                android:textColor="#A69D97" android:textSize="10sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_kw_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="KW"
                android:textColor="#B9AFA9" android:textSize="10sp" android:textStyle="bold" android:includeFontPadding="false" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:background="#1AFFFFFF" />
        <LinearLayout android:id="@+id/day_mo_container" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp" android:layout_marginVertical="1dp">
            <TextView android:id="@+id/day_mo_name" android:layout_width="23dp" android:layout_height="wrap_content" android:text="Mo"
                android:textSize="10sp" android:textColor="#A69D97" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/day_mo_num" android:layout_width="20dp" android:layout_height="wrap_content" android:text="–"
                android:textSize="11sp" android:textColor="#DDD3CD" android:textStyle="bold" android:includeFontPadding="false" />
            <ImageView android:id="@+id/day_mo_dot" android:layout_width="4dp" android:layout_height="4dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_dot_muted" android:importantForAccessibility="no" />
            <TextView android:id="@+id/day_mo_meal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Noch nichts geplant" android:textSize="11sp" android:textColor="#DDD3CD" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
            <TextView android:id="@+id/day_mo_today" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
                android:text="Heute" android:textSize="8sp" android:textStyle="bold" android:textColor="#F08C65" android:visibility="gone" android:includeFontPadding="false" />
        </LinearLayout>
        <LinearLayout android:id="@+id/day_di_container" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp" android:layout_marginVertical="1dp">
            <TextView android:id="@+id/day_di_name" android:layout_width="23dp" android:layout_height="wrap_content" android:text="Di"
                android:textSize="10sp" android:textColor="#A69D97" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/day_di_num" android:layout_width="20dp" android:layout_height="wrap_content" android:text="–"
                android:textSize="11sp" android:textColor="#DDD3CD" android:textStyle="bold" android:includeFontPadding="false" />
            <ImageView android:id="@+id/day_di_dot" android:layout_width="4dp" android:layout_height="4dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_dot_muted" android:importantForAccessibility="no" />
            <TextView android:id="@+id/day_di_meal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Noch nichts geplant" android:textSize="11sp" android:textColor="#DDD3CD" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
            <TextView android:id="@+id/day_di_today" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
                android:text="Heute" android:textSize="8sp" android:textStyle="bold" android:textColor="#F08C65" android:visibility="gone" android:includeFontPadding="false" />
        </LinearLayout>
        <LinearLayout android:id="@+id/day_mi_container" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp" android:layout_marginVertical="1dp">
            <TextView android:id="@+id/day_mi_name" android:layout_width="23dp" android:layout_height="wrap_content" android:text="Mi"
                android:textSize="10sp" android:textColor="#A69D97" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/day_mi_num" android:layout_width="20dp" android:layout_height="wrap_content" android:text="–"
                android:textSize="11sp" android:textColor="#DDD3CD" android:textStyle="bold" android:includeFontPadding="false" />
            <ImageView android:id="@+id/day_mi_dot" android:layout_width="4dp" android:layout_height="4dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_dot_muted" android:importantForAccessibility="no" />
            <TextView android:id="@+id/day_mi_meal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Noch nichts geplant" android:textSize="11sp" android:textColor="#DDD3CD" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
            <TextView android:id="@+id/day_mi_today" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
                android:text="Heute" android:textSize="8sp" android:textStyle="bold" android:textColor="#F08C65" android:visibility="gone" android:includeFontPadding="false" />
        </LinearLayout>
        <LinearLayout android:id="@+id/day_do_container" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp" android:layout_marginVertical="1dp">
            <TextView android:id="@+id/day_do_name" android:layout_width="23dp" android:layout_height="wrap_content" android:text="Do"
                android:textSize="10sp" android:textColor="#A69D97" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/day_do_num" android:layout_width="20dp" android:layout_height="wrap_content" android:text="–"
                android:textSize="11sp" android:textColor="#DDD3CD" android:textStyle="bold" android:includeFontPadding="false" />
            <ImageView android:id="@+id/day_do_dot" android:layout_width="4dp" android:layout_height="4dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_dot_muted" android:importantForAccessibility="no" />
            <TextView android:id="@+id/day_do_meal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Noch nichts geplant" android:textSize="11sp" android:textColor="#DDD3CD" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
            <TextView android:id="@+id/day_do_today" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
                android:text="Heute" android:textSize="8sp" android:textStyle="bold" android:textColor="#F08C65" android:visibility="gone" android:includeFontPadding="false" />
        </LinearLayout>
        <LinearLayout android:id="@+id/day_fr_container" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp" android:layout_marginVertical="1dp">
            <TextView android:id="@+id/day_fr_name" android:layout_width="23dp" android:layout_height="wrap_content" android:text="Fr"
                android:textSize="10sp" android:textColor="#A69D97" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/day_fr_num" android:layout_width="20dp" android:layout_height="wrap_content" android:text="–"
                android:textSize="11sp" android:textColor="#DDD3CD" android:textStyle="bold" android:includeFontPadding="false" />
            <ImageView android:id="@+id/day_fr_dot" android:layout_width="4dp" android:layout_height="4dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_dot_muted" android:importantForAccessibility="no" />
            <TextView android:id="@+id/day_fr_meal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Noch nichts geplant" android:textSize="11sp" android:textColor="#DDD3CD" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
            <TextView android:id="@+id/day_fr_today" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
                android:text="Heute" android:textSize="8sp" android:textStyle="bold" android:textColor="#F08C65" android:visibility="gone" android:includeFontPadding="false" />
        </LinearLayout>
        <LinearLayout android:id="@+id/day_sa_container" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp" android:layout_marginVertical="1dp">
            <TextView android:id="@+id/day_sa_name" android:layout_width="23dp" android:layout_height="wrap_content" android:text="Sa"
                android:textSize="10sp" android:textColor="#A69D97" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/day_sa_num" android:layout_width="20dp" android:layout_height="wrap_content" android:text="–"
                android:textSize="11sp" android:textColor="#DDD3CD" android:textStyle="bold" android:includeFontPadding="false" />
            <ImageView android:id="@+id/day_sa_dot" android:layout_width="4dp" android:layout_height="4dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_dot_muted" android:importantForAccessibility="no" />
            <TextView android:id="@+id/day_sa_meal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Noch nichts geplant" android:textSize="11sp" android:textColor="#DDD3CD" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
            <TextView android:id="@+id/day_sa_today" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
                android:text="Heute" android:textSize="8sp" android:textStyle="bold" android:textColor="#F08C65" android:visibility="gone" android:includeFontPadding="false" />
        </LinearLayout>
        <LinearLayout android:id="@+id/day_so_container" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp" android:layout_marginVertical="1dp">
            <TextView android:id="@+id/day_so_name" android:layout_width="23dp" android:layout_height="wrap_content" android:text="So"
                android:textSize="10sp" android:textColor="#A69D97" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/day_so_num" android:layout_width="20dp" android:layout_height="wrap_content" android:text="–"
                android:textSize="11sp" android:textColor="#DDD3CD" android:textStyle="bold" android:includeFontPadding="false" />
            <ImageView android:id="@+id/day_so_dot" android:layout_width="4dp" android:layout_height="4dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_dot_muted" android:importantForAccessibility="no" />
            <TextView android:id="@+id/day_so_meal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Noch nichts geplant" android:textSize="11sp" android:textColor="#DDD3CD" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
            <TextView android:id="@+id/day_so_today" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
                android:text="Heute" android:textSize="8sp" android:textStyle="bold" android:textColor="#F08C65" android:visibility="gone" android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
