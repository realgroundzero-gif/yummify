<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/shopping_widget_background" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/shopping_widget_background" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
        <LinearLayout android:id="@+id/shopping_widget_header" android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="22dp" android:layout_height="22dp" android:background="@drawable/widget_wordmark_background" android:gravity="center" android:includeFontPadding="false" android:text="y" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:text="yummify" android:textColor="#F7F1EE" android:textSize="13sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Einkaufsliste" android:textColor="#A69D97" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
            <TextView android:id="@+id/shopping_widget_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OFFEN 0 / 0" android:textColor="#B9AFA9" android:textSize="10sp" android:textStyle="bold" android:fontFamily="monospace" android:includeFontPadding="false" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="4dp" android:background="#1AFFFFFF" />
        <ListView android:id="@+id/shopping_widget_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@android:color/transparent" android:dividerHeight="2dp" android:scrollbars="vertical" />
        <LinearLayout android:id="@+id/shopping_widget_preview" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" />
        <TextView android:id="@+id/shopping_widget_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="Deine Einkaufsliste ist leer" android:textColor="#B9AFA9" android:textSize="13sp" android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
